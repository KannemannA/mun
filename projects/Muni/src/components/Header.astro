---
import '@fortawesome/fontawesome-free/css/all.css';
import MenuMovil from "./MenuMovil";
---

<header class="bg-verdeFuerte text-white flex">
  <nav class="flex w-screen justify-between">
    <div class="w-[40%] md:w-1/4 lg:w-1/5">
      <a href="https://www.iguazu.gob.ar">
        <img  src="https://www.iguazu.gob.ar/wp-content/uploads/2021/09/LOGO-ISOTIPO-MUNI-BLANCO-2.svg" alt="" class="h-full w-[70%] sm:w-[60%] md:w-4/5 lg:w-full p-[10px]"
        />
      </a>
    </div>
    <ul class="hidden items-center lg:flex flex-grow">
      <li class="relative group flex-grow">
        <a class="flex justify-center hover:scale-[1.2] duration-[400ms] ease-in-out items-center">
          La Ciudad
          <span class="w-5 flex justify-end"><i class="fa-solid fa-caret-down"></i></span>
        </>
        <ul
          class="absolute left-0 hidden pt-2 bg-white text-green-600 group-hover:block"
        >
          <li>
            <a href="#" class="block px-4 py-2 hover:bg-green-100"
              >El Intendente</a
            >
          </li>
          <li>
            <a href="#" class="block px-4 py-2 hover:bg-green-100"
              >Secretaría de Gobierno</a
            >
          </li>
          <li>
            <a href="#" class="block px-4 py-2 hover:bg-green-100"
              >Reseña Histórica</a
            >
          </li>
          <li>
            <a href="#" class="block px-4 py-2 hover:bg-green-100"
              >Dirección de Patrimonio Histórico</a
            >
          </li>
        </ul>
      </li>
      <li class="relative group flex-grow">
        <a class="flex justify-center hover:scale-[1.2] duration-[400ms] ease-in-out items-center">
          La Municipalidad
          <span class="w-5 flex justify-end"><i class="fa-solid fa-caret-down"></i></span>
        </>
        <ul
          class="absolute left-0 hidden pt-2 bg-white text-green-600 group-hover:block"
        >
          <li>
            <a href="#" class="block px-4 py-2 hover:bg-green-100"
              >Elemento del Submenú 1</a
            >
          </li>
          <li>
            <a href="#" class="block px-4 py-2 hover:bg-green-100"
              >Elemento del Submenú 2</a
            >
          </li>
        </ul>
      </li>
      <li class="relative group flex-grow">
        <a class="flex justify-center hover:scale-[1.2] duration-[400ms] ease-in-out items-center">
          Trámites
          <span class="w-5 flex justify-end"><i class="fa-solid fa-caret-down"></i></span>
        </>
        <ul
          class="absolute left-0 hidden pt-2 bg-white text-green-600 group-hover:block"
        >
          <li>
            <a href="#" class="block px-4 py-2 hover:bg-green-100"
              >Elemento del Submenú 1</a
            >
          </li>
          <li>
            <a href="#" class="block px-4 py-2 hover:bg-green-100"
              >Elemento del Submenú 2</a
            >
          </li>
        </ul>
      </li>
      <li class="hover:scale-[1.2] duration-[400ms] ease-in-out flex-grow">
        <a href="#" class="flex justify-center">Webmail</a>
      </li>
      <li class="hover:scale-[1.2] duration-[400ms] ease-in-out flex-grow">
        <a href="#" class="flex justify-center">Contacto</a>
      </li>
    </ul>
    <MenuMovil client:load />
  </nav>
</header>

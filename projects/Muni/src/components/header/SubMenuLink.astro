---
interface Props {
  border_b?: boolean;
  content: string;
  href?: string;
}

const {
  border_b=false,
  content,
  href="#"} = Astro.props;
---

<li class={border_b ? "border-b" : ""}>
  <a href={href} class="block px-5 py-[15px] hover:text-verdeFuerte transition-colors duration-[400ms] ease-in-out">
    {content}
  </a>
</li>
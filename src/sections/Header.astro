---
import '@fortawesome/fontawesome-free/css/all.css';
import ModalPortal from "../sections/ModalPortal.tsx";
import SubMenuLink from "../components/header/SubMenuLink.astro";
import SubMenu from "../components/header/SubMenu.tsx"
import MenuItemHeader from '../components/header/MenuItemHeader.astro';
import ItemHeader from '../components/header/ItemHeader.astro';

---

<header class="bg-verdeFuerte text-white flex sticky top-0 left-0 z-10">
  <nav class="flex w-screen justify-between items-center">
    <div class="w-[40%] md:w-1/4 lg:w-1/5">
      <a href="https://www.iguazu.gob.ar">
        <img  src="https://www.iguazu.gob.ar/wp-content/uploads/2021/09/LOGO-ISOTIPO-MUNI-BLANCO-2.svg" alt="" class="h-full w-[70%] sm:w-[60%] md:w-4/5 lg:w-full p-[10px]"
        />
      </a>
    </div>
    <ul class="hidden items-center lg:flex flex-grow">
      <MenuItemHeader content='La Ciudad'>
        <SubMenu client:visible>
          <SubMenuLink border_b={true} href='https://www.iguazu.gob.ar/intendente/' content="El Intendente" />
          <SubMenuLink border_b={true} href='https://www.iguazu.gob.ar/secretaria-de-gobierno/' content="Secretaría de Gobierno" />
          <SubMenuLink border_b={true} href='https://www.iguazu.gob.ar/historia/' content="Reseña Histórica" />
          <SubMenuLink href='https://historiadeiguazu.org/' target='_blank' content="Dirección de Patrimonio Histórico" />
        </SubMenu>
      </MenuItemHeader>
      <MenuItemHeader content='La Municipalidad'>
        <SubMenu client:load>
          <SubMenuLink border_b={true} href='https://visitiguazu.travel/' target='_blank' content='Turismo'/>
          <SubMenuLink border_b={true} href='https://www.iguazu.gob.ar/cultura/' content='Cultura'/>
          <SubMenuLink border_b={true} href='https://www.iguazu.gob.ar/deportes-2/' content='Deportes'/>
          <SubMenuLink border_b={true} href='https://www.iguazu.gob.ar/medio-ambiente/' content='Medio Ambiente'/>
          <SubMenuLink border_b={true} href='https://www.iguazu.gob.ar/direccion-de-la-juventud/' content='Dirección de la Juventud'/>
          <SubMenuLink border_b={true} href='https://www.iguazu.gob.ar/oficina-de-empleo/' content='Oficina de Empleo'/>
          <SubMenuLink border_b={true} href='https://www.iguazu.gob.ar/diversidadygeneros/' content='Diversidad y Géneros'/>
          <SubMenuLink border_b={true} href='https://www.iguazu.gob.ar/higiene-y-seguridad/' content='Higiene y Seguridad'/>
          <SubMenuLink border_b={true} href='https://www.iguazu.gob.ar/bromatologia/' content='Bromatología'/>
          <SubMenuLink border_b={true} href='https://www.iguazu.gob.ar/transito/' content='Tránsito'/>
          <SubMenuLink border_b={true} href='https://www.iguazu.gob.ar/zoonosis/' content='Zoonosis'/>
          <SubMenuLink href='https://www.iguazu.gob.ar/vectores/' content='Vectores'/>
        </SubMenu>
      </MenuItemHeader>
      <MenuItemHeader content='Trámites'>
        <SubMenu client:visible>
          <SubMenuLink border_b={true} href='https://www.iguazu.gob.ar/tramites-de-transito/' content='Trámites de tránsito' />
          <SubMenuLink border_b={true} href='https://www.iguazu.gob.ar/tramites-de-bromatologia/' content='Trámites de bromatología' />
          <SubMenuLink border_b={true} href='https://www.iguazu.gob.ar/tramites-del-cementerio/' content='Trámites del cementerio' />
          <SubMenuLink border_b={true} href='https://www.iguazu.gob.ar/tramites-de-pension-por-invalidez/' content='Trámites de pensión por invalidez' />
          <SubMenuLink href='https://www.iguazu.gob.ar/tramites-de-fiscalizacion/' content='Trámites de fiscalización' />
        </SubMenu>
      </MenuItemHeader>
      <ItemHeader href='https://vps-1656188-x.dattaweb.com:2094/login.php?idn' content='Webmail' />
      <ItemHeader href='https://www.iguazu.gob.ar/contacto/' content='Contacto' />
    </ul>
    <ModalPortal client:only="react" trigger='menu movil' content="menu movil" />
  </nav>
</header>

<script>
  let lastScrollTop = 0;
  const header = document.querySelector('header');
  window.addEventListener('scroll', function() {
    const scrollTop = document.documentElement.scrollTop;
    const HeaderHeight = header.clientHeight
    header.style.transform = (scrollTop > lastScrollTop && scrollTop > HeaderHeight) ? 'translateY(-100%)' : 'translateY(0)';
    lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
  });
</script>

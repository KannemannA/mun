{
    "editor.codeActionWidget.includeNearbyQuickFixes": false,
    "editor.suggest.selectionMode": "never",
    "workbench.editor.languageDetectionHints": {
        "untitledEditors": false,
        "notebookEditors": false
    },
    "workbench.editor.showIcons": false,
    "markdown.editor.filePaste.enabled": "never",
    "markdown.editor.drop.enabled": "never",
    "markdown.editor.pasteUrlAsFormattedLink.enabled": "never",
    "editor.quickSuggestions": {
        "strings": true
    },
    "tailwindCSS.includeLanguages": {
        "astro": "html",
        "javascript": "javascript",
        "typescript": "javascript"
    },
    "tailwindCSS.experimental.classRegex": [
        ["Classes \\=([^;]*);", "'([^']*)'"],
        ["Classes \\=([^;]*);", "\"([^\"]*)\""],
        ["Classes \\=([^;]*);", "\\`([^\\`]*)\\`"]
    ],
    "tailwindCSS.showPixelEquivalents": true,
    "tailwindCSS.hovers": true
}
